{
  "manifest_version": 3,
  "key": "",
  "name": "ClipForge \u2014 Video to Clips",
  "version": "1.3.1",
  "description": "Send your YouTube videos or page video URLs to your local ClipForge editor. Transcribe, reframe, caption and export clips.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:43177/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open ClipForge"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:43177; img-src 'self' data: blob: http://127.0.0.1:43177; media-src 'self' blob: http://127.0.0.1:43177"
  }
}
